{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.dev/schemas/dsvire.visual-agent-review-decision.v1.json",
  "title": "DS-ViRe owner-authorized agent annotation review decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_sha256", "registry_sha256", "reviewer", "reviewed_at", "authorization_note", "verification_summary", "decisions"],
  "properties": {
    "schema_version": {"const": "dsvire.visual-agent-review-decision.v1"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "registry_sha256": {"$ref": "#/$defs/sha256"},
    "reviewer": {"type": "string", "pattern": "^agent:[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "authorization_note": {"type": "string", "minLength": 1},
    "verification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documents", "cases", "exact_source_hashes", "excluded_findings"],
      "properties": {
        "documents": {"type": "integer", "minimum": 1},
        "cases": {"type": "integer", "minimum": 1},
        "exact_source_hashes": {"type": "integer", "minimum": 1},
        "excluded_findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/decision"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "outcome", "note"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "outcome": {"enum": ["accepted", "rejected"]},
        "note": {"type": "string"}
      }
    }
  }
}
