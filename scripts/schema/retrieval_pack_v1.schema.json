{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schemas/dsvire/retrieval-pack-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "payload_sha256", "payload"],
  "properties": {
    "schema_version": {"const": "dsvire.retrieval-pack.v1"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "models", "dense_dim", "multi_dim", "vector_dtype", "regions"],
      "properties": {
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "models": {
          "type": "object", "additionalProperties": false, "required": ["dense", "multi"],
          "properties": {
            "dense": {"$ref": "#/$defs/model"},
            "multi": {"$ref": "#/$defs/model"}
          }
        },
        "dense_dim": {"type": "integer", "minimum": 1, "maximum": 8192},
        "multi_dim": {"type": "integer", "minimum": 1, "maximum": 8192},
        "vector_dtype": {"const": "float32"},
        "regions": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/region"}}
      }
    }
  },
  "$defs": {
    "model": {
      "type": "object", "additionalProperties": false, "required": ["id", "sha256"],
      "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "vector": {"type": "array", "minItems": 1, "maxItems": 8192, "items": {"type": "number", "minimum": -1000000, "maximum": 1000000}},
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "page", "bbox_norm", "type", "content_sha256", "text_fields", "dense", "multi"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "page": {"type": "integer", "minimum": 1, "maximum": 100000},
        "bbox_norm": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "type": {"enum": ["pinout", "table", "package"]},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "text_fields": {
          "type": "object", "additionalProperties": false,
          "properties": {"caption": {"type": "string"}, "pins": {"type": "string"}, "section": {"type": "string"}, "crop": {"type": "string"}}
        },
        "dense": {"$ref": "#/$defs/vector"},
        "multi": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/vector"}}
      }
    }
  }
}
