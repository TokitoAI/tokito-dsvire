{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schemas/dsvire.symbol-result.v1.json",
  "title": "dsvire.symbol-result.v1",
  "description": "Standalone schematic symbol compiled from datasheet evidence. The embedded spec remains tokito.symbol-spec.v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "layout_policy_version",
    "spec",
    "pins",
    "citations",
    "svg"
  ],
  "properties": {
    "schema_version": { "const": "dsvire.symbol-result.v1" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manufacturer", "mpn", "package"],
      "properties": {
        "manufacturer": { "type": "string", "minLength": 1 },
        "mpn": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 }
      }
    },
    "layout_policy_version": { "type": "string", "minLength": 1 },
    "spec": { "type": "object" },
    "pins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "name",
          "electrical",
          "style",
          "side",
          "confidence",
          "evidence_region_ids"
        ],
        "properties": {
          "number": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "electrical": { "type": "string", "minLength": 1 },
          "style": { "type": "string", "minLength": 1 },
          "group": { "type": "string" },
          "side": { "enum": ["top", "bottom", "left", "right"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "evidence_region_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "citations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["region_id", "type", "page", "bbox_norm", "content_hash", "crop_uri"],
        "properties": {
          "region_id": { "type": "string" },
          "type": { "type": "string" },
          "page": { "type": "integer", "minimum": 1 },
          "bbox_norm": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number" }
          },
          "content_hash": { "type": "string" },
          "crop_uri": { "type": "string" }
        }
      }
    },
    "svg": { "type": "string", "minLength": 1 }
  }
}
