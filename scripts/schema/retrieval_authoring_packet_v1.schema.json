{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schema/retrieval-authoring-packet-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "plan_sha256", "source_manifest_sha256", "renderer", "requirements", "documents", "packet_sha256"],
  "properties": {
    "schema_version": {"const": "dsvire.retrieval-authoring-packet.v1"},
    "plan_id": {"type": "string", "minLength": 1},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "renderer": {"type": "string", "minLength": 1},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive_region_types", "hard_negative_kinds", "minimum_hard_negatives_per_document", "manual_queries_per_intent_per_document", "annotation_review", "query_review", "prohibited"],
      "properties": {
        "positive_region_types": {"const": ["pinout", "table", "package"]},
        "hard_negative_kinds": {"const": ["wrong_intent", "wrong_package", "wrong_variant", "wrong_view"]},
        "minimum_hard_negatives_per_document": {"const": 4},
        "manual_queries_per_intent_per_document": {"const": 2},
        "annotation_review": {"const": "distinct independent human, blinded to all model scores"},
        "query_review": {"const": "distinct independent human, blinded to all model scores"},
        "prohibited": {"const": ["model-generated queries", "template-only queries", "labels or case IDs in query text", "score access before final seal"]}
      }
    },
    "documents": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "manufacturer", "datasheet_identity", "selected_mpn", "selected_package", "source_sha256", "pages"],
        "properties": {
          "id": {"type": "string", "minLength": 1}, "manufacturer": {"type": "string", "minLength": 1},
          "datasheet_identity": {"type": "string", "minLength": 1}, "selected_mpn": {"type": "string", "minLength": 1},
          "selected_package": {"type": "string", "minLength": 1}, "source_sha256": {"$ref": "#/$defs/sha256"},
          "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["page", "width_points", "height_points", "render_sha256"], "properties": {"page": {"type": "integer", "minimum": 1}, "width_points": {"type": "number", "exclusiveMinimum": 0}, "height_points": {"type": "number", "exclusiveMinimum": 0}, "render_sha256": {"$ref": "#/$defs/sha256"}}}}
        }
      }
    },
    "packet_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
