{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schemas/dsvire.symbol-evidence.v2.json",
  "title": "dsvire.symbol-evidence.v2",
  "description": "Strict DS-ViRe evidence contract with explicit identity and region verifier provenance.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "datasheet", "identity_verification", "regions", "retrieval"],
  "properties": {
    "schema_version": { "const": "dsvire.symbol-evidence.v2" },
    "datasheet": { "$ref": "#/$defs/datasheet" },
    "identity_verification": { "$ref": "#/$defs/identity_verification" },
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/region" }
    },
    "retrieval": { "$ref": "#/$defs/retrieval" }
  },
  "$defs": {
    "datasheet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "content_sha256", "manufacturer", "mpn", "package"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "manufacturer": { "type": "string", "minLength": 1 },
        "mpn": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 }
      }
    },
    "identity_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method", "policy_version", "outcome", "manufacturer_observed",
        "exact_mpn_observed", "package_associated", "evidence_region_ids"
      ],
      "properties": {
        "method": { "const": "exact_text_orderable_part" },
        "policy_version": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["accepted", "rejected", "abstained"] },
        "manufacturer_observed": { "type": "boolean" },
        "exact_mpn_observed": { "type": "boolean" },
        "package_associated": { "type": "boolean" },
        "evidence_region_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^r_[a-z0-9_]+$" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "policy_version", "outcome", "score", "score_semantics"],
      "properties": {
        "method": { "enum": ["text_layout_heuristic", "evidence_gated_visual"] },
        "policy_version": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["accepted", "rejected", "abstained"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "score_semantics": {
          "enum": ["heuristic_evidence_strength", "calibrated_probability"]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "text_layout_heuristic" } } },
          "then": {
            "properties": {
              "score_semantics": { "const": "heuristic_evidence_strength" }
            }
          }
        },
        {
          "if": { "properties": { "method": { "const": "evidence_gated_visual" } } },
          "then": {
            "properties": { "score_semantics": { "const": "calibrated_probability" } }
          }
        }
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region_id", "type", "page", "bbox_norm", "crop_uri", "content_hash",
        "verification"
      ],
      "properties": {
        "region_id": { "type": "string", "pattern": "^r_[a-z0-9_]+$" },
        "type": {
          "enum": ["pinout", "package", "timing", "curve", "block", "app_circuit", "table", "other"]
        },
        "page": { "type": "integer", "minimum": 1 },
        "bbox_norm": {
          "type": "array",
          "items": { "type": "number", "minimum": 0, "maximum": 1 },
          "minItems": 4,
          "maxItems": 4
        },
        "crop_uri": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "verification": { "$ref": "#/$defs/verification" },
        "caption": { "type": "string" }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index_version", "model_ids", "query_ids"],
      "properties": {
        "index_version": { "type": "string", "minLength": 1 },
        "model_ids": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "query_ids": {
          "type": "array", "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
