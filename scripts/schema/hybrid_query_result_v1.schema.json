{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schemas/dsvire/hybrid-query-result-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_sha256", "source_sha256", "models", "routed_types", "considered", "maxsim_evaluated", "hits"],
  "properties": {
    "schema_version": {"const": "dsvire.hybrid-query-result.v1"},
    "pack_sha256": {"$ref": "#/$defs/sha256"},
    "source_sha256": {"$ref": "#/$defs/sha256"},
    "models": {
      "type": "object", "additionalProperties": false, "required": ["dense", "multi"],
      "properties": {"dense": {"$ref": "#/$defs/model"}, "multi": {"$ref": "#/$defs/model"}}
    },
    "routed_types": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"enum": ["pinout", "table", "package"]}},
    "considered": {"type": "integer", "minimum": 1, "maximum": 100000},
    "maxsim_evaluated": {"type": "integer", "minimum": 1, "maximum": 1000},
    "hits": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/hit"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model": {
      "type": "object", "additionalProperties": false, "required": ["id", "sha256"],
      "properties": {"id": {"type": "string", "minLength": 1, "maxLength": 512}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "score": {"type": "number", "minimum": -1000000000000, "maximum": 1000000000000},
    "hit": {
      "type": "object", "additionalProperties": false,
      "required": ["region_id", "page", "type", "content_sha256", "bbox_norm", "score", "bm25_score", "dense_score", "maxsim_score"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1, "maxLength": 1024},
        "page": {"type": "integer", "minimum": 1, "maximum": 100000},
        "type": {"enum": ["pinout", "table", "package"]},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "bbox_norm": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
        "score": {"$ref": "#/$defs/score"},
        "bm25_score": {"$ref": "#/$defs/score"},
        "dense_score": {"$ref": "#/$defs/score"},
        "maxsim_score": {"$ref": "#/$defs/score"}
      }
    }
  }
}
