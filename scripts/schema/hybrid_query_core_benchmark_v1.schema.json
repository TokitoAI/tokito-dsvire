{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schemas/dsvire/hybrid-query-core-benchmark-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system", "scope", "pack", "query", "order_sha256", "runtime", "limitations", "result_sha256"],
  "properties": {
    "schema_version": {"const": "dsvire.hybrid-query-core-benchmark.v1"},
    "system": {"$ref": "#/$defs/identity"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["regions", "queries", "dimension", "patches_per_region", "top_n", "maxsim_k"],
      "properties": {
        "regions": {"type": "integer", "minimum": 1}, "queries": {"type": "integer", "minimum": 1},
        "dimension": {"type": "integer", "minimum": 1, "maximum": 8192}, "patches_per_region": {"type": "integer", "minimum": 1, "maximum": 4096},
        "top_n": {"type": "integer", "minimum": 1, "maximum": 10000}, "maxsim_k": {"type": "integer", "minimum": 1, "maximum": 1000}
      }
    },
    "pack": {
      "type": "object", "additionalProperties": false, "required": ["payload_sha256", "serialized_bytes", "bytes_per_region"],
      "properties": {"payload_sha256": {"$ref": "#/$defs/sha"}, "serialized_bytes": {"type": "integer", "minimum": 1}, "bytes_per_region": {"type": "number", "exclusiveMinimum": 0}}
    },
    "query": {
      "type": "object", "additionalProperties": false, "required": ["mean_ms", "p95_ms", "max_ms"],
      "properties": {"mean_ms": {"type": "number", "minimum": 0}, "p95_ms": {"type": "number", "minimum": 0}, "max_ms": {"type": "number", "minimum": 0}}
    },
    "order_sha256": {"$ref": "#/$defs/sha"}, "result_sha256": {"$ref": "#/$defs/sha"},
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["python", "os", "machine", "total_seconds", "traced_peak_bytes", "pid"],
      "properties": {"python": {"type": "string"}, "os": {"type": "string"}, "machine": {"type": "string"}, "total_seconds": {"type": "number", "minimum": 0}, "traced_peak_bytes": {"type": "integer", "minimum": 0}, "pid": {"type": "integer", "minimum": 1}}
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}}
  }
}
