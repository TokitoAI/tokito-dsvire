{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tokito.ai/schemas/dsvire/model-manifest-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "license", "repositories", "runtime"],
  "properties": {
    "schema_version": {"const": "dsvire.model-manifest.v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 512},
    "license": {"type": "string", "minLength": 1, "maxLength": 512},
    "repositories": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "repository", "revision", "license", "files"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "repository": {"type": "string", "minLength": 1, "maxLength": 512},
          "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "license": {"type": "string", "minLength": 1, "maxLength": 512},
          "files": {
            "type": "array", "minItems": 1, "maxItems": 256,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "bytes", "sha256"],
              "properties": {
                "path": {"type": "string", "pattern": "^[^/\\\\]+$", "maxLength": 1024},
                "bytes": {"type": "integer", "minimum": 1, "maximum": 20000000000},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    "runtime": {"type": "object", "minProperties": 1}
  }
}
