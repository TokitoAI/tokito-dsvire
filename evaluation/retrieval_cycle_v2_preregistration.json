  "acquisition": {
    "allowed_redirects": 5,
    "maximum_pdf_bytes": 67108864,
    "require_pdf_magic": true,
    "require_declared_identity_in_bounded_text": true,
    "on_unavailable_or_mismatched_source": "invalidate_family_without_replacement",
    "post_seal_artifact": "dsvire.retrieval-cycle-source-manifest.v1 with final URL, bytes, and SHA-256"
  },
  "annotation": {
    "region_types": ["pinout", "table", "package"],
    "required_positive_regions_per_family": 3,
    "required_hard_negative_kinds": ["wrong_intent", "wrong_package", "wrong_variant", "wrong_view"],
    "minimum_hard_negatives_per_family": 4,
    "review_protocol": "two-pass blinded review; author and adjudicator cannot inspect model scores",
    "disagreements": "adjudicate before query encoding; unresolved regions are excluded and recorded"
  },
  "queries": {
    "authoring": "manual natural-language prompts written after region adjudication and before model scoring",
    "intents": ["pinout", "table", "package"],
    "queries_per_intent_per_family": 2,
    "minimum_total": 72,
    "review_protocol": "second reviewer checks intent, exact identity, relevance, and hard-negative links without model scores",
    "prohibited": ["template-only queries", "model-generated queries", "post-score edits", "labels or case IDs in query text"]
  },
  "candidate_universe": {
    "crop_ranking": "every adjudicated region in the selected split for every query",
    "full_page_baseline": "every rendered page in the selected split for every query",
    "unannotated_figures": "not silently counted as negatives; record judgment incompleteness separately",
    "maxsim_k": 32
  },
  "systems": {
    "candidate": "pinned ColSmol crop BM25+dense/RRF+MaxSim cascade",
    "comparators": ["same pinned ColSmol over naive full pages", "pinned unscoped OpenCLIP over crops", "unscoped BM25 text-RAG over crop text"]
  },
  "metrics": ["nDCG@5", "R@5", "mAP", "MRR", "coverage", "hard-negative-at-5", "wrong-figure acceptance", "query p95", "pages/s/GPU", "compressed pack bytes"],
  "frozen_gate": {
    "evaluation_queries_minimum": 36,
    "coverage_minimum": 1.0,
    "crop_recall_at_5_vs_full_page_minimum_delta": -0.01,
    "crop_recall_at_5_vs_openclip_minimum_delta": 0.15,
    "crop_recall_at_5_vs_text_rag_minimum_delta": 0.15,
    "verified_wrong_figure_rate_maximum": 0.02,
    "target_gpu_hot_query_p95_ms_maximum": 800,
    "crop_index_pages_per_second_per_gpu_minimum": 2.0,
    "compressed_crop_pack_vs_full_page_ratio_maximum": 0.15,
    "all_conditions_required": true
  },
  "execution_order": [
    "merge this pre-registration unchanged",
    "acquire and hash official sources into a separate immutable manifest",
    "annotate calibration and evaluation without model scores",
    "author and review queries without model scores",
    "run calibration systems and freeze any candidate policy",
    "run evaluation systems exactly once",
    "publish passing or failing compact evidence without retuning"
  ],
  "invalidation": [
    "family/source identity mismatch or unavailable official source",
    "family overlap with any previously consumed registry group",
    "score access before annotation and query review are sealed",
    "threshold, metric, comparator, split, or query mutation after this plan merges",
    "substitution of unofficial mirror bytes",
    "tuning on evaluation outcomes"
  ],
  "publication_policy": "automated catalog publication remains disabled unless this exact held-out gate passes and the separate deterministic EGVV/publication contract is satisfied"
