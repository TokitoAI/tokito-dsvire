# Copy to `.env` locally. Never commit real secrets.
# Production refuses to start without a service token of at least 32 bytes.

DSVIRE_ENVIRONMENT=development
DSVIRE_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
# DSVIRE_ALLOW_INSECURE_DEV=true

# Optional durable platform (leave unset for the single-process API)
# DSVIRE_PLATFORM_ENABLED=true
# DSVIRE_DATABASE_URL=postgres://dsvire:dsvire@127.0.0.1:5432/dsvire
# DSVIRE_REDIS_URL=redis://127.0.0.1:6379/0
# DSVIRE_QDRANT_URL=http://127.0.0.1:6333
# DSVIRE_QDRANT_API_KEY=
# DSVIRE_PUBLIC_BASE_URL=https://dsvire.example.invalid
# DSVIRE_OBJECT_BUCKET=dsvire
# DSVIRE_OBJECT_ENDPOINT=
# DSVIRE_OBJECT_REGION=us-east-1
# DSVIRE_OBJECT_ACCESS_KEY=
# DSVIRE_OBJECT_SECRET_KEY=
# DSVIRE_LOCAL_OBJECT_DIR=.cache/object-store
